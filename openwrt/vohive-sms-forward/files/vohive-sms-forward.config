config vohive 'main'
	# Dedicated SMS modem only. Verify the modem before enabling the service.
	option enabled '0'
	option data_dir '/etc/vohive-sms-forward/data'
	# Service always runs with -sms-only=true. Turning mobile data off can
	# reboot compatible Baiwang firmware. Notifications use the router's WAN.
	option archive_delete '0'
	option vid '2ca3'
	option pid '4006'
	option at_interface '3'
